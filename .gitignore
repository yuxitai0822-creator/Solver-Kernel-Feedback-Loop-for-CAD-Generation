.env
__pycache__/
*.pyc
dataset/__pycache__/

# Per-triplet artefacts inside experiments/phase2b_triplets/<sid>__<nid>/:
# the agent-generated code, executed STEP, log files.  We DO commit
# the per-triplet triplet.json (small) and the SUMMARY / manifest
# files at the root of phase2b_triplets/.
experiments/phase2b_triplets/*/code_gt.py
experiments/phase2b_triplets/*/code_perturbed.py
experiments/phase2b_triplets/*/step_gt/
experiments/phase2b_triplets/*/step_perturbed/

# Per-trial artefacts from experiments/phase2b_m0m3/<method>/<sid>/<nid>/iter_XX/:
# written by p2b_m0m3_on_frozen.py during repair iterations.  We DO commit
# the aggregate pilot_results.json + REPORT.md + SIGNIFICANCE.md + log.
experiments/phase2b_m0m3/*/code_perturbed_input.py
experiments/phase2b_m0m3/*/iter_*/
