{
  "schema_version": "cad_ir_v0.1",
  "sample_id": "manual_demo_constraint_dim",
  "unit": "mm",
  "coordinate_system": {"up_axis": "z", "front_axis": "y", "right_axis": "x"},
  "operations": [
    {
      "op_id": "op_001",
      "op_type": "sketch_rectangle",
      "role": "base_profile",
      "plane": "XY",
      "params": {
        "width": 50.0,
        "height": 30.0,
        "center": [0.0, 0.0]
      }
    },
    {
      "op_id": "op_002",
      "op_type": "add_constraint",
      "params": {
        "constraint_type": "horizontal",
        "target": "op_001"
      }
    },
    {
      "op_id": "op_003",
      "op_type": "set_dimension",
      "params": {
        "dimension_type": "linear",
        "target": "op_001",
        "value": 50.0
      }
    },
    {
      "op_id": "op_004",
      "op_type": "extrude",
      "role": "base_body",
      "input": "op_001",
      "params": {
        "distance": 8.0,
        "extent_type": "one_side",
        "operation": "new_body",
        "direction": "+normal"
      }
    },
    {
      "op_id": "op_005",
      "op_type": "export_step",
      "input": "op_004",
      "params": {"path": "manual_demo_constraint_dim.step"}
    }
  ]
}